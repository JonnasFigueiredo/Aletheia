# LLM provider selection: mock | openai | anthropic | custom
LLM_PROVIDER=mock

# Base URL for the LLM API (required for openai/custom; omit for anthropic)
# Examples:
#   OpenAI:   https://api.openai.com/v1
#   DeepSeek: https://api.deepseek.com/v1
#   Ollama:   http://localhost:11434/v1
LLM_BASE_URL=

# API key for the selected provider (not required for mock)
LLM_API_KEY=

# Model identifier (e.g. gpt-4o-mini, claude-3-5-haiku-20241022, llama3.2)
LLM_MODEL=

# Sampling temperature (0 = deterministic, range 0-2 for OpenAI)
ALETHEIA_TEMPERATURE=0

# Path to the mock fixture YAML file, relative to the project root
ALETHEIA_FIXTURE_PATH=fixtures/mock-responses.yaml

# HTTP timeout in seconds for real providers
LLM_TIMEOUT_SECONDS=30

# Embedding model for semantic_similarity evaluator (OpenAI-compatible providers)
EMBED_MODEL=text-embedding-3-small
