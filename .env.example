# LLM provider selection: mock | openai | anthropic | custom
LLM_PROVIDER=mock

# Base URL for the LLM API (required for custom providers)
LLM_BASE_URL=

# API key for the selected provider
LLM_API_KEY=

# Model identifier (e.g. gpt-4o-mini, claude-3-5-haiku-20241022)
LLM_MODEL=

# Sampling temperature (0 = deterministic, range 0-2 for OpenAI)
ALETHEIA_TEMPERATURE=0
